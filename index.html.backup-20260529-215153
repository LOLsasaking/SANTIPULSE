      </div>
    </div>
  `);

  const messages = document.getElementById('chatMessages');
  const form = document.getElementById('chatForm');
  const input = document.getElementById('chatInput');

  function addMsg(text, isBot = false) {
    const div = document.createElement('div');
    div.className = `flex ${isBot ? 'justify-start' : 'justify-end'}`;
    div.innerHTML = `
      <div class="${isBot ? 'bg-electric/20 text-white' : 'bg-electric text-navy'} rounded-2xl px-4 py-3 max-w-[80%] text-sm leading-relaxed">
        ${text}
      </div>
    `;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  setTimeout(() => {
    addMsg('¡Hola! 👋 Soy el chatbot de Santipulse. Estoy en fase de prueba. Pronto podré responder con IA real conectada a Supabase. ¿Quieres saber más sobre nuestros servicios?', true);
  }, 300);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const txt = input.value.trim();
    if (!txt) return;
    addMsg(txt);
    input.value = '';
    setTimeout(() => {
      addMsg('Gracias por tu mensaje. Esta es una demo previa — la versión final conectará con IA real para darte respuestas inteligentes. ¿Quieres que te avise cuando esté lista? Escríbenos a santipulse@gmail.com', true);
    }, 700);
  });
}

