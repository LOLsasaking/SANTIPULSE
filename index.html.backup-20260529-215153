<style>
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', sans-serif;
    background: #0F172A;
    color: #fff;
    overflow-x: hidden;
  }
  .font-display { font-family: 'Space Grotesk', sans-serif; }

  /* Fondo grid sutil */
  .bg-grid {
    background-image:
      linear-gradient(rgba(96,165,250,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96,165,250,0.05) 1px, transparent 1px);
    background-size: 70px 70px;
  }

  /* Logo hover */
  .logo-hover {
    transition: transform 0.7s ease, filter 0.7s ease;
  }
  .logo-hover:hover {
    transform: rotate(45deg);
    filter: drop-shadow(0 0 12px rgba(255,255,255,0.4));
  }

  /* Gradiente texto */
  .text-gradient {
    background: linear-gradient(135deg, #fff 0%, #93C5FD 60%, #60A5FA 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Botón premium */
  .btn-primary {
    background: linear-gradient(135deg, #60A5FA, #3B82F6);
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(96,165,250,0.25);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(96,165,250,0.45);
  }
  .btn-ghost {
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }
  .btn-ghost:hover {
    background: rgba(96,165,250,0.08);
    border-color: rgba(96,165,250,0.5);
  }

  /* Tarjeta */
  .card {
    background: linear-gradient(145deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(255,255,255,0.08);
    transition: all 0.4s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(96,165,250,0.35);
    box-shadow: 0 20px 50px rgba(96,165,250,0.12);
  }

  /* Reveal on scroll */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Modal */
  .modal-backdrop {
    backdrop-filter: blur(8px);
    background: rgba(10,16,32,0.85);
  }
  .modal-content {
    background: linear-gradient(145deg, #0F172A, #1E293B);
    border: 1px solid rgba(96,165,250,0.2);
    box-shadow: 0 30px 90px rgba(0,0,0,0.6);
  }

  /* Nav blur */
  .nav-blur {
    backdrop-filter: blur(20px);
    background: rgba(15,23,42,0.78);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  /* Loading screen */
  #loadingScreen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0F172A;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }
  #loadingScreen.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .loader-logo {
    width: 140px;
    height: 140px;
    animation: loaderPulse 1.6s ease-in-out infinite;
    filter: drop-shadow(0 0 30px rgba(96,165,250,0.5));
  }
  @keyframes loaderPulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.08); opacity: 1; }
  }
  .loader-bar {
    margin-top: 32px;
    width: 180px;
    height: 2px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .loader-bar::before {
    content: '';
    display: block;
    height: 100%;
    width: 30%;
    background: linear-gradient(90deg, transparent, #60A5FA, transparent);
    animation: loaderSlide 1.4s ease-in-out infinite;
  }
  @keyframes loaderSlide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(500%); }
  }
  .loader-text {
    margin-top: 20px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    letter-spacing: 0.3em;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
  }

  /* Imagen logo (chrome 3D) en navbar/footer */
  .logo-img {
    transition: transform 0.5s ease, filter 0.5s ease;
  }
  .logo-img:hover {
    transform: rotate(45deg);
    filter: drop-shadow(0 0 12px rgba(96,165,250,0.6));
  }

  /* Vídeo logo animado en el hero (chroma-keyed) */
  .hero-logo-video {
    width: 200px;
    height: 200px;
    object-fit: contain;
    filter: drop-shadow(0 0 30px rgba(96,165,250,0.35));
    mix-blend-mode: screen; /* funde el negro del fondo del vídeo con el hero oscuro */
  }
  @media (min-width: 768px) {
    .hero-logo-video {
      width: 260px;
      height: 260px;
    }
  }

  /* Placeholder dashed */
  .placeholder-box {
    border: 1.5px dashed rgba(96,165,250,0.3);
    background: rgba(96,165,250,0.03);
  }

  /* Bandera badge */
  .flag-badge {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .no-scroll { overflow: hidden; }
</style>
</head>
