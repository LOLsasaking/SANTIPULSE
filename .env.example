# ============================================================
# Santipulse — environment variables
# LOCAL:  copy to ".env.local" and fill in (gitignored).
# VERCEL: add the same keys in Project -> Settings -> Environment Variables.
# ============================================================

# --- Supabase (REQUIRED for the form to save) ---
# NOTE: must be the API URL (xxxxx.supabase.co), NOT the dashboard URL.
# This is the LIVE project (verified working). The old cskk... project was wrong.
SUPABASE_URL=https://mhgvevpshoebskqumrex.supabase.co
# SERVICE ROLE key (server-only — NEVER expose in the browser).
# Supabase -> Settings -> API -> service_role -> Reveal
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# ANON / publishable key (PUBLIC — safe for the browser; baked into /login & /dashboard).
# Supabase -> Settings -> API -> anon public
SUPABASE_ANON_KEY=your_anon_public_key_here

# Salt for hashing visitor IPs (any long random string)
IP_SALT=change-me-to-a-random-string

# --- Stripe (REQUIRED for billing: checkout, webhook, portal) ---
# Keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
# Webhook signing secret (Developers -> Webhooks -> your endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Recurring monthly Price IDs (Products -> each product -> price_XXXX)
STRIPE_PRICE_STARTER=price_XXXX
STRIPE_PRICE_PRO=price_XXXX
STRIPE_PRICE_AGENCY=price_XXXX

# --- Email (REQUIRED for notifications + visitor auto-reply) ---
# Key at https://resend.com -> API Keys
RESEND_API_KEY=
LEAD_NOTIFY_TO=santiagogoncalves07@gmail.com
# Must use the VERIFIED domain in Resend (santipulse.com is verified):
LEAD_NOTIFY_FROM=leads@santipulse.com

# --- Build (OPTIONAL) ---
# Absolute URL used for canonical/hreflang/OG/sitemap. Real production domain:
SITE_URL=https://santipulse.com

# ============================================================
# Client automations: Cold Outreach · Cart Recovery · Social Scheduler
# ALL OPTIONAL & ENV-GATED. If a block is absent, that integration reports
# "not configured" (503) and its dashboard card shows nothing to connect —
# the rest of the site is unaffected. Fill a block to switch one on.
# ============================================================

# --- Gmail (Google OAuth) — send transport for Outreach + Cart Recovery ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add this Authorized redirect URI:
#   https://santipulse.com/api/integrations/gmail/callback/
# Enable the "Gmail API". Requires the `googleapis` npm package (installed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Shopify (app OAuth) — abandoned-cart source for Cart Recovery ---
# Shopify Partners -> Apps -> your app -> Client credentials.
# App URL / Allowed redirection URL:
#   https://santipulse.com/api/integrations/shopify/callback/
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Meta (Facebook/Instagram Graph) — Social Scheduler ---
# Meta for Developers -> your app -> App settings -> Basic.
# Facebook Login -> Valid OAuth Redirect URI:
#   https://santipulse.com/api/integrations/social/callback/
# Needs pages_manage_posts / instagram_content_publish (App Review for prod).
META_APP_ID=
META_APP_SECRET=

# --- Cron worker auth (REQUIRED for the background worker to run) ---
# Vercel automatically sends "Authorization: Bearer $CRON_SECRET" to the
# scheduled function (vercel.json "crons"). Set any long random string.
# Without it, /api/cron/process refuses to run (fail-closed).
CRON_SECRET=change-me-to-a-long-random-string
